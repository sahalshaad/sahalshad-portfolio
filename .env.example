# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# Supabase PostgreSQL connection string
# Find this in: Supabase → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.womxalxttugmkpgslqwg.supabase.co:5432/postgres

# Django secret key — generate a new one for production:
# python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-this-secret-key

# Set to False in production
DJANGO_DEBUG=True
